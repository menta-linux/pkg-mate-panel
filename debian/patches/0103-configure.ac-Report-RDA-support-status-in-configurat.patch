From 20aac0103471370ec99405b4515405214a68b694 Mon Sep 17 00:00:00 2001
From: Mike Gabriel <mike.gabriel@das-netzwerkteam.de>
Date: Thu, 28 Jun 2018 15:39:47 +0200
Subject: [PATCH 3/6] configure.ac: Report RDA support status in configuration
 summary.

Signed-off-by: Mike Gabriel <mike.gabriel@das-netzwerkteam.de>
---
--- a/configure.ac
+++ b/configure.ac
@@ -388,6 +388,7 @@
 
 dnl ---------------------------------------------------------------------------
 dnl - Show summary
+        RDA support:                   ${have_rda}
 dnl ---------------------------------------------------------------------------
 
 echo "
@@ -412,6 +413,7 @@
         Wayland support:               ${have_wayland}
         X11 support:                   ${have_x11}
         XRandr support:                ${have_randr}
+        RDA support:                   ${have_rda}
         Evolution Data Server support: ${have_eds}
         Build introspection support:   ${found_introspection}
         Build gtk-doc documentation:   ${enable_gtk_doc}
