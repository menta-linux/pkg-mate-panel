+void
+panel_shell_monitors_changed (void)
+{
+	if (dbus_connection == NULL || shell_object_id == 0)
+		return;
+
+	g_dbus_connection_emit_signal (dbus_connection, NULL,
+				       PANEL_DBUS_SHELL_PATH, PANEL_DBUS_SHELL_IFACE,
+				       "MonitorsChanged", NULL, NULL);
+}
